    {
      "id": "abraham",
      "name": "亚伯拉罕",
      "kind": "person",
      "gender": "male",
      "fatherId": null,
      "relation": "起点",
      "refs": [
        "创世记17:5",
        "创世记21:1–5",
        "创世记25:1–9"
      ],
      "events": [
        {
          "text": "原名亚伯兰，蒙赐名为亚伯拉罕。",
          "refs": [
            "创世记17:5"
          ]
        },
        {
          "text": "撒拉给他生以撒；生以撒时年一百岁。",
          "refs": [
            "创世记21:1–5"
          ]
        },
        {
          "text": "将产业给以撒，并将财物分给庶出的众子。",
          "refs": [
            "创世记25:5–6"
          ]
        },
        {
          "text": "寿数一百七十五年，由以撒和以实玛利安葬。",
          "refs": [
            "创世记25:7–9"
          ]
        }
      ],
      "notes": "本图从亚伯拉罕开始。撒拉是以撒的母亲，夏甲是以实玛利的母亲，基土拉生了另外六子；主线经以撒至雅各。",
      "aliases": [
        "亚伯兰"
      ]
    },
