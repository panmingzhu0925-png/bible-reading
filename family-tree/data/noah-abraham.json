      ],
      "events": [
        {
          "text": "接待为以撒求婚的亚伯拉罕仆人，与彼土利回应婚事。",
          "refs": [
            "创世记24:29–32",
            "创世记24:50–51"
          ]
        },
        {
          "text": "后来迎接外甥雅各；他的两位女儿是利亚与拉结。",
          "refs": [
            "创世记29:13",
            "创世记29:16"
          ]
        }
      ],
      "notes": "彼土利之子、利百加的哥哥、利亚与拉结之父。创28:5直接说明彼土利是其父，不能只按兄妹称谓省略核对。本页在两女的婚姻交接处收束，不声称拉班只有两个孩子。",
      "gender": "male"
    },
    {
      "id": "rebecca",
      "name": "利百加",
      "kind": "person",
      "fatherId": "bethuel",
