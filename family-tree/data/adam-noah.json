  "nodes": [
    {
      "id": "adam",
      "name": "亚当",
      "kind": "person",
      "gender": "male",
      "fatherId": null,
      "relation": "起点",
      "refs": [
        "创世记2:7",
        "创世记4:1–2",
        "创世记4:25",
        "创世记5:1–5"
      ],
      "events": [
        {
          "text": "由神用尘土造成人，被安置在伊甸园看守修理。",
          "refs": [
            "创世记2:7–8",
            "创世记2:15"
          ]
        },
        {
          "text": "吃了被禁止的果子，后来被遣出伊甸园。",
          "refs": [
            "创世记3:6",
            "创世记3:17",
            "创世记3:23–24"
          ]
        },
        {
          "text": "130岁时生塞特；此后又活800年，还有其他未具名儿女。",
          "refs": [
            "创世记5:3–4"
          ]
        },
        {
          "text": "寿命共930年。",
          "refs": [
            "创世记5:5"
          ]
        }
      ],
      "notes": "夏娃是配偶，不是女儿；本图不把创造叙述转换为人类父子关系。只列本段具名子女，该隐、亚伯、塞特不代表亚当全部儿女。"
    },
    {
      "id": "eve",
      "name": "夏娃",
      "kind": "person",
      "gender": "female",
      "fatherId": null,
      "relation": "配偶档案",
      "refs": [
        "创世记2:21–25",
        "创世记3:20",
        "创世记4:1–2",
        "创世记4:25"
      ],
      "events": [
        {
          "text": "神用从亚当所取的肋骨造女人，带到亚当面前。",
          "refs": [
            "创世记2:21–22"
          ]
        },
        {
          "text": "听信蛇的引诱，吃果子并给丈夫。",
          "refs": [
            "创世记3:1–6"
          ]
        },
        {
          "text": "亚当为妻子起名夏娃。",
          "refs": [
            "创世记3:20"
          ]
        },
        {
          "text": "生该隐、亚伯，后来又生塞特。",
          "refs": [
            "创世记4:1–2",
            "创世记4:25"
          ]
        }
      ],
      "notes": "她是亚当的妻子，也是该隐、亚伯和塞特的母亲；经文未记她的寿数。"
    },
    {
      "id": "cain",
      "name": "该隐",
      "kind": "person",
      "gender": "male",
      "fatherId": "adam",
      "relation": "儿子",
      "refs": [
        "创世记4:1"
      ],
      "events": [
        {
          "text": "从事耕种，以地里出产献供物。",
          "refs": [
            "创世记4:2–3"
          ]
        },
        {
          "text": "在田间杀害兄弟亚伯，受责问与惩罚。",
          "refs": [
            "创世记4:8–12"
          ]
        },
        {
          "text": "受记号保护，后来迁居伊甸东面的挪得。",
          "refs": [
            "创世记4:15–16"
          ]
        },
        {
          "text": "与未具名妻子生以诺，并以儿子的名字命名所建之城。",
          "refs": [
            "创世记4:17"
          ]
        }
      ],
      "notes": "妻子未具名，也未在本段说明其父母，不凭推测命名或补出身份。以诺城只作经历，不另画成人物。经文未记该隐寿数。"
    },
    {
      "id": "abel",
      "name": "亚伯",
      "kind": "person",
      "gender": "male",
      "fatherId": "adam",
      "relation": "儿子",
      "refs": [
        "创世记4:1–2"
      ],
      "events": [
        {
          "text": "从事牧羊，将羊群中的供物献给神。",
          "refs": [
            "创世记4:2",
            "创世记4:4"
          ]
        },
        {
          "text": "在田间被兄弟该隐杀害。",
          "refs": [
            "创世记4:8"
          ]
        }
      ],
      "notes": "经文未记寿数、配偶或子女，不能用空子树断言他终身没有配偶。"
    },
    {
